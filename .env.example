# Wikitude Titanium Sample - Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env files to version control (see .gitignore)

# Wikitude SDK License Key
# Obtain from https://www.wikitude.com/download/
# This is required for the AR functionality to work
WIKITUDE_LICENSE_KEY=your_license_key_here

# Server Configuration (for POI data samples)
# The sample uses a demo server at example.wikitude.com
# For production, replace with your own POI data server
POI_DATA_SERVER_URL=https://example.wikitude.com/GetSamplePois/
POI_DATA_SERVER_LAT_PARAM=lat
POI_DATA_SERVER_LON_PARAM=lon
POI_DATA_SERVER_NR_POIS_PARAM=nrPois

# Application Configuration
APP_ID=com.wikitude.titaniumsample
APP_NAME=ModuleSamples
APP_VERSION=5.3.1

# Platform-specific settings
# iOS
IOS_MIN_VERSION=8.0
IOS_CAMERA_USAGE_DESCRIPTION="Accessing the Camera is required to run the Wikitude SDK"
IOS_LOCATION_USAGE_DESCRIPTION="Accessing GPS information is needed to display POIs around your current location"
IOS_PHOTO_LIBRARY_USAGE_DESCRIPTION="Access to your photo library is required for the example 'Bonus: Capture Screen'"

# Android
ANDROID_INSTALL_LOCATION=auto
ANDROID_ANY_DENSITY=true

# Analytics (optional)
ENABLE_ANALYTICS=true
ACS_AUTH_BASE_URL_DEVELOPMENT=https://secure-identity.cloud.appcelerator.com
ACS_BASE_URL_DEVELOPMENT=https://api.cloud.appcelerator.com
ACS_AUTH_BASE_URL_PRODUCTION=https://secure-identity.cloud.appcelerator.com
ACS_BASE_URL_PRODUCTION=https://api.cloud.appcelerator.com

# Development/Debug
NODE_ENV=development
LOG_LEVEL=debug